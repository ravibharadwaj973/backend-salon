model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String?
  code           String?
  firstName      String
  lastName       String?
  phone          String
  altPhone       String?
  email          String?
  gender         Gender?
  dob            DateTime? @db.Date
  anniversary    DateTime? @db.Date
  addressLine    String?
  city           String?
  pincode        String?
  source         LeadSource @default(WALK_IN)
  sourceDetail   String?
  referredById   String?
  preferredStaffId String?
  tags           String[] @default([])
  notes          String?
  tier           CustomerTier @default(BRONZE)
  isActive       Boolean  @default(true)
  isBlacklisted  Boolean  @default(false)

  whatsappConsent ConsentStatus @default(UNKNOWN)
  smsConsent      ConsentStatus @default(UNKNOWN)
  emailConsent    ConsentStatus @default(UNKNOWN)

  /// WHETHER THE ADDRESS WORKS — WHICH IS NOT WHETHER THEY WANT TO HEAR FROM US.
  ///
  /// Consent is the customer's decision and only the customer can change it.
  /// Reachability is a fact about a phone number or an email address, and the
  /// provider tells us.
  ///
  /// They were the same field until now: a hard bounce set emailConsent to
  /// OPTED_OUT. That is wrong in both directions. A customer who mistyped their
  /// address at the counter is recorded as having refused marketing, which is a
  /// lie about a person; and when the address is corrected, the correction does
  /// not help, because the consent it overwrote is gone for good.
  ///
  /// Separating them also lets the app answer a question it could not before:
  /// "how many of my customers can I actually reach?" — as against how many
  /// agreed to be reached.
  whatsappStatus    ReachStatus @default(UNKNOWN)
  whatsappLastError String?
  whatsappCheckedAt DateTime?

  smsStatus    ReachStatus @default(UNKNOWN)
  smsLastError String?
  smsCheckedAt DateTime?

  emailStatus    ReachStatus @default(UNKNOWN)
  emailLastError String?
  emailCheckedAt DateTime?
  consentUpdatedAt DateTime?

  // denormalised rollups, maintained by billing/appointment services
  firstVisitAt   DateTime?
  lastVisitAt    DateTime?
  totalVisits    Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(14, 2)
  avgBill        Decimal  @default(0) @db.Decimal(12, 2)
  loyaltyPoints  Int      @default(0)
  walletBalance  Decimal  @default(0) @db.Decimal(12, 2)
  outstanding    Decimal  @default(0) @db.Decimal(12, 2)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)

  /// THE CUSTOMER'S OWN CLOCK. Maintained alongside the rollups above.
  ///
  /// "Not seen in 45 days" is wrong for almost everybody: a three-weekly
  /// haircut is a month late at 45 days, and a twice-a-year balayage is
  /// perfectly on schedule. These three columns let a segment ask "late for
  /// THEM?" instead, in plain indexed SQL rather than in memory.
  ///
  /// visitIntervalDays is the median gap over their recent visits — the median
  /// because one year abroad would otherwise double a monthly regular's cycle
  /// and stop the salon chasing them. Null until three intervals exist, since
  /// a single gap is a coincidence, not a habit.
  visitIntervalDays    Int?
  /// How many intervals the figure rests on. 0 means the salon-wide fallback.
  visitIntervalBasis   Int      @default(0)
  /// When they are due, on their own clock. Indexed: this is what "due now"
  /// and "due this week" segments actually filter on.
  expectedNextVisitAt  DateTime?
  /// Where they sit on the ladder, recomputed with the rollups.
  lifecycleStage       LifecycleStage @default(NEVER_VISITED)

  /// Missed appointments, for the segments that protect chair time.
  noShowCount    Int      @default(0)
  /// What they last actually bought — different services have different
  /// natural cycles, and a colour reminder to a waxing customer is noise.
  lastServiceCategoryId String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  referredBy     Customer? @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      Customer[] @relation("CustomerReferral")
  preferredStaff Staff?    @relation("PreferredStaff", fields: [preferredStaffId], references: [id], onDelete: SetNull)

  appointments        Appointment[]
  invoices            Invoice[]
  payments            Payment[]
  notesLog            CustomerNote[]
  photos              CustomerPhoto[]
  hairProfile         HairProfile?
  packagePurchases    PackagePurchase[]
  memberships         MembershipSubscription[]
  loyaltyTxns         LoyaltyTransaction[]
  rewardRedemptions   RewardRedemption[]
  walletTxns          WalletTransaction[]
  feedback            Feedback[]
  messages            MessageLog[]
  journeyRuns         JourneyRun[]
  segmentMembers      SegmentMember[]
  enrollments         ChallengeEnrollment[]
  waitlistEntries     Waitlist[]
  couponRedemptions   CouponRedemption[]
  convertedFromLead   Lead[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastVisitAt])
  @@index([tenantId, branchId])
  @@index([tenantId, tier])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, expectedNextVisitAt])
  @@map("customers")
}

