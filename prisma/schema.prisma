// ============================== PLATFORM ====================================

/// Where an enquiry is in your pipeline. Deliberately short: a list with nine
/// statuses is a list nobody keeps up to date.
enum EnquiryStatus {
  NEW
  CONTACTED
  DEMO_BOOKED
  TRIAL_STARTED
  WON
  LOST
}

/// A salon that asked to hear from you.
///
/// This is the whole of what the marketing site collects: no password, no
/// account, nothing provisioned. Someone fills in the form, you read it in the
/// console, and you ring them. A salon becomes a tenant only when a person
/// decides it should — at which point `convertedTenantId` records which one.
///
/// Not tenant-scoped: an enquiry exists before any salon does, so it sits
/// alongside PlatformUser rather than under a tenant.
model Enquiry {
  id         String        @id @default(cuid())
  salonName  String
  contactName String
  email      String
  phone      String
  city       String?
  /// How many chairs, roughly — the one qualifying question worth asking up front.
  size       String?
  /// Anything they wanted to tell you. Their words, untouched.
  message    String?

  status     EnquiryStatus @default(NEW)
  /// Where they came from: the pricing page, the home page, a campaign.
  source     String?
  /// Free notes from whoever is working the pipeline.
  notes      String?

  contactedAt DateTime?
  /// Set when this enquiry became a real salon.
  convertedTenantId String?
  convertedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("enquiries")
}

model PlatformUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_users")
}

/// What a message is metered against. WhatsApp is split by template category
/// because the underlying cost is not comparable: Meta charges roughly 7.5x more
/// for a marketing template than a utility one, so a single "messages" number
/// would let a salon spend a marketing budget out of a utility allowance.
enum MeterKey {
  WA_UTILITY
  WA_MARKETING
  WA_AUTHENTICATION
  SMS
  EMAIL
}

/// Why a credit balance moved. Consumption rows are only written when purchased
/// credits are spent — messages covered by the monthly plan allowance are counted
/// in MessageUsage instead, and every message is already in MessageLog.
enum CreditEntryReason {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  EXPIRY
}

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  pricePerMonth   Decimal  @db.Decimal(12, 2)
  pricePerYear    Decimal? @db.Decimal(12, 2)
  maxBranches     Int      @default(1)
  maxStaff        Int      @default(10)
  maxCustomers    Int      @default(5000)

  /// Monthly allowances, reset on the 1st of each calendar month in the tenant's
  /// timezone. Zero means the plan does not include that channel at all.
  waUtilityQuota     Int @default(500)
  waMarketingQuota   Int @default(0)
  waAuthQuota        Int @default(0)
  smsQuota           Int @default(250)
  emailQuota         Int @default(2000)

  /// Campaigns the salon may start each calendar month. Resets on the 1st, like
  /// the message allowances. Use FAIR_USE_UNLIMITED for "as many as they like".
  maxCampaignsPerMonth Int @default(3)

  /// How far a meter may go below zero so that work already under way can
  /// finish. This is not extra allowance to spend — it exists so a campaign
  /// that is halfway through its recipients does not strand the other half
  /// mid-send. Crossing into it stops everything new immediately.
  overdraftLimit Int @default(200)

  /// Charged per branch beyond maxBranches. Null means extra branches are refused
  /// rather than sold.
  extraBranchPrice Decimal? @db.Decimal(12, 2)

  /// Feature switches, keyed by the strings in core/features.ts.
  features        Json     @default("{}")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]
  packs   CreditPack[]

  @@map("plans")
}

/// The add-on catalogue. Buying a pack tops up a balance that carries over month
/// to month — unlike the plan allowance, which resets.
/// Which sending account a channel uses for one salon.
enum MessagingSetupStatus {
  NOT_CONNECTED
  PENDING
  CONNECTED
  FAILED
}

/// A salon's own sending accounts.
///
/// WhatsApp messages must arrive from the salon's number, not the platform's —
/// a customer who gets "your appointment is confirmed" from an unknown business
/// blocks it. Meta's model is one WhatsApp Business Account per business, so
/// credentials belong to the tenant, not to the deployment.
///
/// Everything here falls back to the environment when absent, which is what
/// lets a demo tenant work before any of it is set up.
model TenantMessagingConfig {
  id       String  @id @default(cuid())
  tenantId String  @unique

  // --- WhatsApp Cloud API (per salon, via Meta embedded signup) ---
  waStatus         MessagingSetupStatus @default(NOT_CONNECTED)
  /// Meta's id for this salon's number. Unique across the platform because one
  /// WhatsApp number belongs to exactly one salon — and because every webhook
  /// arrives carrying only this id, so it is how an inbound event finds the
  /// tenant it belongs to. Without that lookup a STOP from one salon's
  /// customer would be applied to every salon.
  waPhoneNumberId  String?  @unique
  waBusinessId     String?
  /// Stored server-side only and never returned to the browser in full.
  waAccessToken    String?
  /// When Meta says this token stops working. A system-user token is
  /// effectively permanent and leaves this null; the 24-hour tokens from the
  /// dashboard do not, and knowing which is which is the difference between
  /// "reconnect WhatsApp" and messages silently failing.
  waTokenExpiresAt DateTime?
  waDisplayNumber  String?
  waVerifiedAt     DateTime?

  // --- SMS (MSG91 or compatible; India needs a DLT-registered header) ---
  smsStatus     MessagingSetupStatus @default(NOT_CONNECTED)
  smsSenderId   String?
  smsApiKey     String?
  /// DLT principal entity id, required by Indian operators.
  smsDltEntityId String?
  smsRoute      String?

  // --- Email ---
  emailStatus    MessagingSetupStatus @default(NOT_CONNECTED)
  emailFromName  String?
  emailFromAddress String?
  emailApiKey    String?
  emailReplyTo   String?

  // --- Sending suspension ---
  /// True once the salon has overdrawn its allowance. Nothing new sends until a
  /// platform operator clears it, which they do after being paid.
  sendingBlocked Boolean   @default(false)
  blockedAt      DateTime?
  blockedReason  String?
  /// Messages already delivered beyond the allowance, owed by the salon. Cleared
  /// when the block is lifted.
  owedMessages   Int       @default(0)
  unblockedAt    DateTime?
  unblockedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_messaging_config")
}

model CreditPack {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  meter     MeterKey
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  /// Optional: restrict a pack to one plan (e.g. bulk packs only for Business).
  planId    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan    Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  entries CreditLedger[]

  @@index([meter, isActive])
  @@map("credit_packs")
}

/// One row per tenant per meter per month. `included` is snapshotted when the row
/// is created, so changing a plan mid-month does not silently rewrite what the
/// salon was already told they had.
model MessageUsage {
  id          String   @id @default(cuid())
  tenantId    String
  meter       MeterKey
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  included    Int      @default(0)
  used        Int      @default(0)
  /// Sends refused because both the allowance and the credit balance were empty.
  blocked     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter, periodStart])
  @@index([tenantId, periodStart])
  @@map("message_usage")
}

/// Purchased credits, per meter. Spent only after the monthly allowance is gone.
model CreditBalance {
  id        String   @id @default(cuid())
  tenantId  String
  meter     MeterKey
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, meter])
  @@map("credit_balances")
}

/// Every movement of a purchased balance, so "where did my 5,000 messages go"
/// has an answer. Payments are recorded by hand — there is no gateway anywhere in
/// this system — so amountPaid/paymentMode/reference are what the operator typed
/// in after the money arrived.
model CreditLedger {
  id           String            @id @default(cuid())
  tenantId     String
  meter        MeterKey
  delta        Int
  balanceAfter Int
  reason       CreditEntryReason
  packId       String?
  messageLogId String?
  amountPaid   Decimal?          @db.Decimal(12, 2)
  paymentMode  PaymentMode?
  reference    String?
  note         String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pack   CreditPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([tenantId, meter, createdAt])
  @@map("credit_ledger")
}

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  legalName  String?
  gstin      String?
  phone      String
  email      String
  addressLine String?
  city       String?
  state      String?
  stateCode  String?
  pincode    String?
  country    String       @default("IN")
  currency   String       @default("INR")
  timezone   String       @default("Asia/Kolkata")
  locale     String       @default("en-IN")
  logoUrl    String?
  status     TenantStatus @default(TRIAL)
  trialEndsAt DateTime?
  planId     String?
  settings   Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  plan Plan? @relation(fields: [planId], references: [id])

  branches              Branch[]
  users                 User[]
  customers             Customer[]
  services              Service[]
  serviceCategories     ServiceCategory[]
  staff                 Staff[]
  appointments          Appointment[]
  invoices              Invoice[]
  settingsKv            Setting[]
  subscriptions         TenantSubscription[]
  messageUsage          MessageUsage[]
  creditBalances        CreditBalance[]
  creditLedger          CreditLedger[]
  messagingConfig       TenantMessagingConfig?

  @@index([status])
  @@map("tenants")
}

model TenantSubscription {
  id             String   @id @default(cuid())
  tenantId       String
  planCode       String
  startedAt      DateTime @default(now())
  currentPeriodEnd DateTime
  amount         Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("tenant_subscriptions")
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, key])
  @@map("settings")
}

// ============================== ORG =========================================

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  phone        String?
  email        String?
  addressLine  String?
  city         String?
  state        String?
  stateCode    String?
  pincode      String?
  gstin        String?
  timezone     String   @default("Asia/Kolkata")
  region       String?
  openingHours Json     @default("{}") // { "1": [{"open":"10:00","close":"20:00"}], ... 0=Sunday }
  slotIntervalMin Int   @default(15)
  /// How many appointments this shop will let the INTERNET book into one moment.
  ///
  /// Null, the default, means "as many as there are stylists free" — capacity
  /// derived from the rota, which is right for a salon where every stylist has
  /// their own chair. It is wrong for a salon with six stylists and three
  /// chairs, or one that wants to keep a chair back for walk-ins, and until now
  /// there was no way for them to say so.
  ///
  /// It is a ceiling, not a replacement: a slot still needs a stylist who can
  /// do the work and is free. And it binds online booking only — the front desk
  /// can always overbook, because a receptionist looking at a real room knows
  /// things this number does not.
  maxConcurrentBookings Int?
  /// The salon's own Google review link, pasted from Google Business Profile.
  /// Per branch: each shop has its own listing, and a review on the wrong one is wasted.
  googleReviewUrl String?
  invoicePrefix String  @default("INV")
  /// Superseded by InvoiceSeries, which can restart and can hold more than one
  /// series. Kept so the numbers already issued can be migrated across, and so
  /// a rollback cannot lose a branch's position in its own series.
  invoiceCounter Int    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userBranches   UserBranch[]
  staff          Staff[]
  resources      Resource[]
  appointments   Appointment[]
  invoices       Invoice[]
  expenses       Expense[]
  stocks         Stock[]
  stockMovements StockMovement[]
  settings       Setting[]
  customers      Customer[]
