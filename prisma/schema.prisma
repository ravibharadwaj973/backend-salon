// ============================================================================
// SALON OS — multi-tenant salon management platform
// One SaaS, configurable per tenant. Every tenant-scoped table carries
// tenantId and is force-filtered by the Prisma tenant extension.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

