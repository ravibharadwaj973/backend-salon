model Segment {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  isDynamic       Boolean  @default(true)
  rules           Json     @default("{}") // { all: [ {field, op, value}, ... ] }
  lastCount       Int      @default(0)
  lastComputedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members   SegmentMember[]
  campaigns Campaign[]

  @@unique([tenantId, name])
  @@map("segments")
}

model SegmentMember {
  id         String   @id @default(cuid())
  tenantId   String
  segmentId  String
  customerId String
  addedAt    DateTime @default(now())

  segment  Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@index([tenantId])
  @@map("segment_members")
}

model MessageTemplate {
  id             String                 @id @default(cuid())
  tenantId       String
  /// Set when this was installed from the template library, so the salon can be
  /// shown what they already have. Null for templates they wrote themselves.
  libraryKey     String?
  name           String
  channel        Channel
  /// What this template is FOR, as far as anyone here is concerned — and, once
  /// it has been submitted, whatever Meta decided it is instead.
  ///
  /// Meta re-reads the wording at review and files the template under the
  /// category the content belongs to, ignoring the one submitted. This column
  /// holds their answer, because it is the one that governs sending: MARKETING
  /// requires an explicit opt-in, UTILITY does not.
  category       TemplateCategory       @default(UTILITY)
  /// The category we ASKED for, kept only so the app can say that Meta
  /// disagreed. Null until the template has been submitted.
  requestedCategory TemplateCategory?
  language       String                 @default("en")
  providerTemplateName String?
  /// Meta's own id for this template, returned when it is submitted. Present
  /// only for templates that exist on a WABA.
  providerTemplateId   String?
  /// Why Meta refused it, in Meta's words. Paraphrasing it helps nobody: the
  /// salon has to change the thing Meta objected to, not a summary of it.
  rejectedReason       String?
  submittedAt          DateTime?
  /// Last time the status here was checked against Meta's.
  syncedAt             DateTime?
  /// Our variable names in the order Meta numbered them, recorded at submission.
  ///
  /// Meta stores {{1}}, {{2}}; we store {{customer_name}}. The mapping is fixed
  /// the moment a template is approved. Deriving it from the body at send time
  /// instead works right up until somebody reorders a sentence, after which
  /// every customer receives another customer's values with no error anywhere.
  metaVariableOrder    String[]  @default([])
  headerText     String?
  bodyText       String
  footerText     String?
  buttons        Json                   @default("[]")
  variables      String[]               @default([])
  approvalStatus TemplateApprovalStatus @default(DRAFT)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  campaigns    Campaign[]
  journeySteps JourneyStep[]
  messages     MessageLog[]

  @@unique([tenantId, name, channel])
  @@map("message_templates")
}

model Campaign {
  id           String         @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  channel      Channel
  templateId   String?
  segmentId    String?
  status       CampaignStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  costPerMessage Decimal      @default(0) @db.Decimal(8, 4)
  objective    CampaignObjective @default(OTHER)
  /// The campaign this one follows up, when it targets a group defined by
  /// what people did with an earlier send rather than by a segment rule.
  followUpOfId String?
  /// Which of that campaign's outcome groups this one goes to.
  ///
  /// Resolved at SEND time, never at creation: a follow-up scheduled for
  /// Thursday and aimed at "read but has not booked" must not reach somebody
  /// who booked on Wednesday. Keeping it as a rule rather than a copied list
  /// is what makes that true without any stop-the-follow-up machinery.
  followUpAudience CampaignAudience?
  /// How long after EACH RECIPIENT'S delivery a booking or visit still counts.
  ///
  /// Per recipient, not per campaign: a campaign that goes out over five days
  /// gives the person reached on the fifth day the same window as the first.
  /// Anchoring everyone to the campaign's start would quietly shorten the
  /// window for everybody it reached late.
  attributionWindowDays Int   @default(14)
  /// Which of booking, visit and revenue this campaign is being judged on.
  conversionEvents ConversionEvent[] @default([BOOKING, VISIT, REVENUE])
  variables    Json           @default("{}")

  targetCount    Int     @default(0)
  sentCount      Int     @default(0)
  deliveredCount Int     @default(0)
  readCount      Int     @default(0)
  clickedCount   Int     @default(0)
  /// Customers who wrote back. The strongest signal short of a booking.
  repliedCount   Int     @default(0)
  failedCount    Int     @default(0)
  /// Recipients who did something with it — read, clicked or wrote back.
  ///
  /// The stage the funnel was missing. Between "it arrived" and "they came" is
  /// "they looked", and without it a campaign that nobody opened is
  /// indistinguishable from one that everybody opened and ignored.
  engagedCount   Int     @default(0)
  /// Recipients who BOOKED inside their window. Appointments, not invoices.
  bookingCount   Int     @default(0)
  /// Recipients who actually CAME. A booking that turns into a no-show is
  /// counted above and not here, which is how the two stay tellable apart.
  visitCount     Int     @default(0)
  revenue        Decimal @default(0) @db.Decimal(14, 2)
  /// Set when attribution last ran, so a half-finished run is visible.
  attributedAt   DateTime?
  cost           Decimal @default(0) @db.Decimal(12, 2)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  segment  Segment?         @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  messages MessageLog[]
  leads    Lead[]
  /// Self-relation: a follow-up points at the campaign whose recipients it is
  /// drawn from, so the chain is walkable in both directions.
  followUpOf Campaign?  @relation("CampaignFollowUps", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUps  Campaign[] @relation("CampaignFollowUps")

  @@index([tenantId, status])
  @@index([followUpOfId])
  @@map("campaigns")
}

/// A link in a message, rewritten so the tap can be counted.
///
/// This is the only measurement SMS can ever have — a carrier reports that a
/// message was delivered and nothing more, so without this an SMS campaign is
/// spend with no outcome attached. It earns its place on WhatsApp and email
/// too, where a click is the action closest to a booking.
model TrackedLink {
  id        String   @id @default(cuid())
  tenantId  String
  /// What appears in the message: /r/<code>. Short because an SMS is billed
  /// by the character and a long link eats a second segment.
  code      String   @unique
  /// Where the customer actually ends up.
  targetUrl String
  /// The message this link was put in, so a tap can move that message to
  /// CLICKED and be credited to the right campaign.
  messageLogId String?
  campaignId   String?
  customerId   String?

  clickCount   Int       @default(0)
  firstClickAt DateTime?
  lastClickAt  DateTime?
  createdAt    DateTime  @default(now())

  messageLog MessageLog? @relation(fields: [messageLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId])
  @@index([messageLogId])
}

model MessageLog {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String?
  channel      Channel
  /// Snapshotted from the template at queue time. A template's category can be
  /// changed later; what it was billed as must not move with it.
  category     TemplateCategory @default(UTILITY)
  /// What this message was FOR — see MessagePurpose. Snapshotted alongside
  /// category, and for the same reason.
  purpose      MessagePurpose @default(OTHER)
  meter        MeterKey?
  customerId   String?
  leadId       String?
  campaignId   String?
  journeyRunId String?
  templateId   String?
  toAddress    String
  payload      Json          @default("{}")
  renderedBody String?
  status       MessageStatus @default(QUEUED)
  providerMessageId String?
  errorCode    String?
  errorMessage String?
  cost         Decimal       @default(0) @db.Decimal(8, 4)
  queuedAt     DateTime      @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  clickedAt    DateTime?
  /// When the customer wrote back, if they did.
  repliedAt    DateTime?
  attributedInvoiceId String?
  attributedRevenue   Decimal @default(0) @db.Decimal(12, 2)
  /// The start of this recipient's own window — their delivery, or their send
  /// when the channel never confirmed delivery.
  ///
  /// Stored rather than recomputed so an attribution can be explained months
  /// later: "counted because they visited on 2 October, inside 25 September to
  /// 16 October" is answerable, and a recomputed window is not.
  attributionFrom     DateTime?
  attributionUntil    DateTime?
  /// The appointment this recipient booked inside the window, if any.
  attributedAppointmentId String?
  /// How many times they came inside the window. More than one is common on a
  /// long window, and counting only the first understates the campaign.
  attributedVisits    Int     @default(0)

  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign   Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  journeyRun JourneyRun?      @relation(fields: [journeyRunId], references: [id], onDelete: SetNull)
  trackedLinks TrackedLink[]

  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([tenantId, customerId, queuedAt])
  @@index([providerMessageId])
  /// The analytics read path: every funnel query filters a date range and
  /// groups by purpose and channel.
  @@index([tenantId, queuedAt, purpose, channel])
  @@map("message_logs")
}

model Journey {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  trigger       JourneyTrigger
  triggerConfig Json           @default("{}") // e.g. { days: 60 }
  audienceRules Json           @default("{}")
  isActive      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  steps JourneyStep[]
  runs  JourneyRun[]

  @@unique([tenantId, name])
  @@index([tenantId, trigger, isActive])
  @@map("journeys")
}

model JourneyStep {
  id           String            @id @default(cuid())
  tenantId     String
  journeyId    String
  sortOrder    Int
  actionType   JourneyActionType @default(SEND_MESSAGE)
  delayMinutes Int               @default(0)
  channel      Channel?
  templateId   String?
  config       Json              @default("{}")
  condition    Json              @default("{}")

  journey  Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([journeyId, sortOrder])
  @@index([tenantId])
  @@map("journey_steps")
}

model JourneyRun {
  id          String           @id @default(cuid())
  tenantId    String
  journeyId   String
  customerId  String?
  leadId      String?
  status      JourneyRunStatus @default(ACTIVE)
  currentStep Int              @default(0)
  nextRunAt   DateTime?
  context     Json             @default("{}")
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  lastError   String?

  journey  Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  messages MessageLog[]

  @@index([tenantId, status, nextRunAt])
  @@index([journeyId, customerId])
  @@map("journey_runs")
}

// ============================== REVIEWS =====================================

model Feedback {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String
  appointmentId String?  @unique
  customerId    String?
  staffId       String?
  rating        Int
  serviceRating Int?
  ambienceRating Int?
  /// How the stylist was, and whether the wait was acceptable — the two things
  /// a salon can actually act on.
  staffRating   Int?
  waitRating    Int?
  npsScore      Int?
  comment       String?
  isComplaint   Boolean  @default(false)
  resolvedAt    DateTime?
  resolutionNote String?
  googleReviewRequested Boolean @default(false)
  /// Set when the customer actually tapped through to Google, not when we asked.
  googleReviewedAt DateTime?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, rating])
  @@map("feedback")
}

// ============================== GAMIFICATION ================================

model Challenge {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  type         ChallengeType
  targetValue  Decimal       @db.Decimal(12, 2)
  durationDays Int           @default(30)
  rewardPoints Int           @default(0)
  rewardId     String?
  startAt      DateTime
  endAt        DateTime
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  enrollments ChallengeEnrollment[]

  @@unique([tenantId, name])
  @@map("challenges")
}

model ChallengeEnrollment {
  id          String           @id @default(cuid())
  tenantId    String
  challengeId String
  customerId  String
  progress    Decimal          @default(0) @db.Decimal(12, 2)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([challengeId, customerId])
  @@index([tenantId, status])
  @@map("challenge_enrollments")
}

// ============================== INVENTORY ===================================

model Brand {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model ProductCategory {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@unique([tenantId, name])
  @@map("product_categories")
}

model Supplier {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  contactName  String?
  phone        String?
  email        String?
  gstin        String?
  addressLine  String?
  paymentTerms String?
  isActive     Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String
  brandId       String?
  categoryId    String?
  name          String
  sku           String?
  shade         String?
  unit          String   @default("ml") // ml | g | pcs
  packSize      Decimal  @default(1) @db.Decimal(12, 3)
  costPrice     Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @db.Decimal(12, 2)
  taxRatePct    Decimal  @default(18) @db.Decimal(5, 2)
  hsnSac        String?
  isRetail      Boolean  @default(false)
  isConsumable  Boolean  @default(true)
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 3)
  trackExpiry   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  stocks      Stock[]
  movements   StockMovement[]
  batches     ProductBatch[]
  consumption ServiceConsumption[]
  poItems     PurchaseOrderItem[]

  @@unique([tenantId, name, shade])
  @@index([tenantId, isActive])
  @@map("products")
}

model ProductBatch {
  id         String    @id @default(cuid())
  tenantId   String
  productId  String
  branchId   String
  batchNo    String?
  expiryDate DateTime? @db.Date
  quantity   Decimal   @default(0) @db.Decimal(12, 3)
  costPrice  Decimal   @default(0) @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, branchId])
  @@index([tenantId, expiryDate])
  @@map("product_batches")
}

model Stock {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId])
  @@map("stocks")
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  branchId  String
  productId String
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3) // signed: + in, - out
  unitCost  Decimal           @default(0) @db.Decimal(12, 2)
  balanceAfter Decimal        @default(0) @db.Decimal(12, 3)
  refType   String?
  refId     String?
  invoiceId String?
  batchId   String?
  notes     String?
  createdById String?
  createdAt DateTime          @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, productId, createdAt])
  @@index([tenantId, type, createdAt])
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String
  branchId     String
  supplierId   String
  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)
  orderedAt    DateTime            @default(now())
  expectedAt   DateTime?
  receivedAt   DateTime?
  subTotal     Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)
  invoiceRef   String?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id           String  @id @default(cuid())
  tenantId     String
  purchaseOrderId String
  productId    String
  quantity     Decimal @db.Decimal(12, 3)
  receivedQty  Decimal @default(0) @db.Decimal(12, 3)
  unitCost     Decimal @db.Decimal(12, 2)
  taxRatePct   Decimal @default(18) @db.Decimal(5, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  batchNo      String?
  expiryDate   DateTime? @db.Date

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

// ============================== EXPENSES ====================================

model ExpenseCategory {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  isFixed   Boolean @default(false)
  isActive  Boolean @default(true)

  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id          String      @id @default(cuid())
  tenantId    String
  branchId    String
  categoryId  String
  expenseDate DateTime    @db.Date
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  vendor      String?
  reference   String?
  notes       String?
  isRecurring Boolean     @default(false)
  attachmentUrl String?
  createdById String?
  createdAt   DateTime    @default(now())

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, expenseDate])
