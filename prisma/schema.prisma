// ============================== BILLING / POS ===============================

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  branchId       String
  invoiceNumber  String
  customerId     String?
  appointmentId  String?       @unique
  invoiceDate    DateTime      @default(now())
  isGst          Boolean       @default(true)
  /// What this bill was CALLED when it was issued: "Tax Invoice", "Bill of
  /// Supply" or "Invoice".
  ///
  /// Snapshotted rather than derived at print time. A salon that registers for
  /// GST in November must not have last June's bills silently reprint as tax
  /// invoices showing a GSTIN it did not hold then — that is a rewritten
  /// record, and reprinting an old bill is exactly when it would happen.
  documentTitle  String?
  placeOfSupply  String?
  isInterState   Boolean       @default(false)

  grossAmount    Decimal       @default(0) @db.Decimal(12, 2)
  itemDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  billDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  discountReason String?
  couponId       String?
  taxableAmount  Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalTax       Decimal       @default(0) @db.Decimal(12, 2)
  roundOff       Decimal       @default(0) @db.Decimal(6, 2)
  grandTotal     Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)

  status         InvoiceStatus @default(DRAFT)
  notes          String?
  /// The unguessable half of the customer's link to this bill.
  ///
  /// Deliberately not the row's own id: an id that appears in customers'
  /// WhatsApp messages is no longer internal, and welding a public address to
  /// a primary key means neither can change without breaking the other. Issued
  /// on demand, so invoices nobody ever shared have no public address at all.
  publicToken    String?       @unique
  sentOnWhatsappAt DateTime?
  createdById    String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items        InvoiceItem[]
  payments     Payment[]
  refunds      Refund[]
  commissions  CommissionEntry[]
  loyaltyTxns  LoyaltyTransaction[]
  redemptions  PackageRedemption[]
  stockMovements StockMovement[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, branchId, invoiceDate])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("invoices")
}

/// A BILL NUMBER COUNTER, ONE ROW PER SERIES.
///
/// `Branch.invoiceCounter` was a single running integer, which could only ever
/// produce one shape of number and could never restart. This replaces it, and
/// the `key` is what makes the difference: it holds the financial year when the
/// salon wants numbering to restart each April, and the empty string when they
/// want one continuous series.
///
/// Putting the year in the KEY rather than in a flag beside the counter means
/// the database's own unique constraint is what prevents two tills issuing the
/// same bill number on 1 April, rather than application code remembering to.
/// A duplicate bill number is not a glitch — it is a defective invoice on both
/// bills and an unanswerable question at audit.
model InvoiceSeries {
  id       String @id @default(cuid())
  tenantId String
  branchId String
  /// "25-26" when numbering resets yearly; "" when it runs continuously.
  key      String
  /// The highest number ISSUED. The next bill is this plus one.
  lastNumber Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([tenantId])
  @@map("invoice_series")
}

model InvoiceItem {
  id            String           @id @default(cuid())
  tenantId      String
  branchId      String
  invoiceId     String
  itemType      InvoiceItemType
  refId         String? // serviceId | productId | packageTemplateId | membershipPlanId
  name          String
  hsnSac        String?
  staffId       String?
  quantity      Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal          @db.Decimal(12, 2)
  discount      Decimal          @default(0) @db.Decimal(12, 2)
  taxableValue  Decimal          @db.Decimal(12, 2)
  taxRatePct    Decimal          @default(0) @db.Decimal(5, 2)
  cgstAmount    Decimal          @default(0) @db.Decimal(12, 2)
  sgstAmount    Decimal          @default(0) @db.Decimal(12, 2)
  igstAmount    Decimal          @default(0) @db.Decimal(12, 2)
  lineTotal     Decimal          @db.Decimal(12, 2)
  redeemedFrom  RedemptionSource @default(NONE)
  packagePurchaseItemId String?
  membershipSubscriptionId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, itemType, refId])
  @@index([tenantId, staffId])
  @@map("invoice_items")
}

model Payment {
