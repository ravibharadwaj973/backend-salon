# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
# summary = one line per request · off = errors only · full = everything
HTTP_LOG=summary
SLOW_QUERY_MS=250
# Which sites may call the AUTHENTICATED API. Comma-separated, no spaces needed.
#
# Only our own signed-in apps belong here: the salon app and the platform
# console. The marketing site and a salon's own website talk to /public only,
# which answers ANY origin by design — the booking widget runs on sites we have
# never heard of — so listing them here is unnecessary.
#
# Accepts exact origins and one-label wildcards, and forgives a trailing slash:
#   CORS_ORIGINS=https://app.parlon.in,https://admin.parlon.in
#   CORS_ORIGINS=https://*.vercel.app        every preview deployment
#   CORS_ORIGINS=*                           anything — development only
#
# Scheme and port are part of an origin: https://x and http://x are different,
# and so are :3000 and :3001. A refused origin is logged once, with the list it
# was checked against, so a missing entry is a five-second fix.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where the salon app is served to the public. Every customer-facing link is
# built from this: the booking page a salon embeds in their own website, the
# feedback link in a WhatsApp message, the Google-review hand-off. It must be
# the address a customer's phone can open, so set it to your real domain in
# production. /public is CORS-open regardless, because the booking widget runs
# on the salon's own website.
PUBLIC_APP_URL=http://localhost:3000

# This API's own public address, if it is NOT served from PUBLIC_APP_URL behind
# the same proxy. Only used to build the <script src> a salon pastes into their
# website. Leave unset when the two share a domain.
# PUBLIC_API_URL=https://api.parlon.in

# ---------- Database ----------
# Matches the development database container:
#   docker run -d --name parlon-db -e POSTGRES_USER=gym_app \
#     -e POSTGRES_PASSWORD=salongrow_dev_2026 -e POSTGRES_DB=salon_os \
#     -p 5432:5432 -v parlon-pgdata:/var/lib/postgresql/data postgres:17
#
# The container creates the database on first start, so there is nothing to make
# by hand — `npx prisma db push` builds the tables into it. Not `migrate dev`:
# this project has no migrations directory.
#
# Keep the password free of @ : / # and ? — they are URL delimiters, and a
# password containing one must be percent-encoded or the connection fails with
# an authentication error that looks like the wrong password.
DATABASE_URL="postgresql://gym_app:salongrow_dev_2026@localhost:5432/salon_os?schema=public"

# On the server, where docker-compose.yml runs the database alongside the API,
# the host is the SERVICE NAME, not localhost — each container has its own
# localhost, and the API's does not have Postgres on it:
#
#   DATABASE_URL=postgresql://salon_app:<password>@salon-db:5432/salon_crm_db?schema=public
#   POSTGRES_USER=salon_app
#   POSTGRES_PASSWORD=<the same password, and a real one>
#   POSTGRES_DB=salon_crm_db
#
# Compose reads POSTGRES_* to create the database on first start; the API reads
# DATABASE_URL to connect to it. The user, password and database name must
# match across the two or the API starts and fails to authenticate.

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# ---------- Platform ----------
PLATFORM_ADMIN_EMAIL=admin@parlon.in
PLATFORM_ADMIN_PASSWORD=Admin@12345

# ---------- Jobs ----------
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=5000
JOB_BATCH_SIZE=25

# ---------- Messaging ----------
MESSAGING_DRIVER=console            # console | whatsapp_cloud | gupshup
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# A string you invent. Put the same value in Meta's webhook form; it only
# proves to Meta that the endpoint is yours. `openssl rand -hex 16` is fine.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# From your Meta app's Basic Settings. Every webhook is signed with it, and
# without it anyone who finds the webhook URL can post fake delivery receipts
# or forge a STOP that unsubscribes a salon's customers.
WHATSAPP_APP_SECRET=
# Platform fallbacks only — each salon connects its own accounts in the app.
SMS_DRIVER=console            # console | msg91
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
# Email via Resend (https://resend.com). Paste the key and a from-address on a
# domain you have verified there; the driver switches on by itself. Use
# onboarding@resend.dev only for testing — it can only mail your own inbox.
#
# The from-address must be ON the verified domain, not merely mention it:
# with mail.jharavi.in verified, hello@mail.jharavi.in works and
# hello@jharavi.in does not — Resend treats the subdomain as its own domain.
#
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   RESEND_FROM_EMAIL=hello@mail.jharavi.in
#   RESEND_FROM_NAME=Parlon
#
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# The generic names still work if you prefer them:
EMAIL_DRIVER=console          # console | resend (auto when RESEND_API_KEY is set)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ---------- Business defaults ----------
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_GST_RATE=18
